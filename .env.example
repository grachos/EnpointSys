# ---- EndpointSys backend configuration (copy to .env and fill in) ----

# HTTP port the Express server listens on
PORT=5000

# REQUIRED: JWT signing secret. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# HMAC secret used to sign public documentation share tokens.
# Defaults to JWT_SECRET if not set.
DOCS_TOKEN_SECRET=

# ---- MySQL connection (use a dedicated least-privilege DB user in production) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=endpointsys
DB_PASSWORD=
DB_NAME=endpointsys_db
DB_POOL_LIMIT=50

# Comma-separated list of origins allowed by CORS (the Vite dev server + your prod domain)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Per-request JSON body size limit
BODY_LIMIT=2mb

# Maximum history entries kept per user
HISTORY_LIMIT=200